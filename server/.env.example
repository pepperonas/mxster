# Copy to server/.env (dev) or /opt/mxtape-api/.env (prod, mode 640). Never commit .env.
MX_ENV=dev
PUBLIC_URL=http://localhost:5174
MX_PORT=4274
MX_DB_PATH=data/mxtape.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-openssl-rand-hex-32
MXTAPE_ADMIN_EMAILS=martinpaush@gmail.com
# Dev only: /api/auth/dev-login?email=...  (refused in prod)
MX_DEV_LOGIN=true
# Mail: SMTP (implicit TLS, port 465) or a sendmail binary. Both empty = disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDMAIL_PATH=
NOTIFY_EMAIL=martinpaush@gmail.com
MAIL_FROM=mxtape <support@celox.io>
