# Copy to server/.env (dev) or /opt/mxster-api/.env (prod, mode 640). Never commit .env.
MX_ENV=dev
PUBLIC_URL=http://localhost:5174
MX_PORT=4274
MX_DB_PATH=data/mxster.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me-openssl-rand-hex-32
MXSTER_ADMIN_EMAILS=martinpaush@gmail.com
# Dev only: /api/auth/dev-login?email=...  (refused in prod)
MX_DEV_LOGIN=true
# Prod: /usr/sbin/sendmail (msmtp). Empty = mail disabled.
SENDMAIL_PATH=
NOTIFY_EMAIL=martinpaush@gmail.com
